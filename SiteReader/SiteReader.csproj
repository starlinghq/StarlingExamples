<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <StarlingsVersion>0.5.0</StarlingsVersion>
    <!-- cpu (default) or cuda. For CUDA, build with -p:NativeRuntime=cuda and run each command with the cuda option. -->
    <NativeRuntime Condition="'$(NativeRuntime)' == ''">cpu</NativeRuntime>
    <NuGetLockFilePath Condition="'$(NativeRuntime)' == 'cuda'">packages.cuda.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Brings Microsoft.ML (MLContext, k-means) and Starlings.Models.E5. -->
    <PackageReference Include="Starlings.Models.E5.MLNet" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Gliner2" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Qwen35.OnnxGenAI" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Qwen35.Extensions.AI" Version="$(StarlingsVersion)" />
    <!-- look and find: images and text in one embedding space, with SkiaSharp decoding the screenshots. -->
    <PackageReference Include="Starlings.Models.EmbeddingGemma2" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.EmbeddingGemma2.Imaging.SkiaSharp" Version="$(StarlingsVersion)" />
    <!-- HTML parsing for the crawler; a headless browser for look. -->
    <PackageReference Include="AngleSharp" Version="1.9.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Exactly one ONNX Runtime native package (and one GenAI package), chosen by the application. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" Condition="'$(NativeRuntime)' == 'cpu'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" Condition="'$(NativeRuntime)' == 'cpu'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.30.0" Condition="'$(NativeRuntime)' == 'cuda'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.17.1" Condition="'$(NativeRuntime)' == 'cuda'" />
  </ItemGroup>
  <ItemGroup>
    <None Include="sample-site/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
