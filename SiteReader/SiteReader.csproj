<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <StarlingsVersion>0.5.0</StarlingsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Brings Microsoft.ML (MLContext, k-means) and Starlings.Models.E5. -->
    <PackageReference Include="Starlings.Models.E5.MLNet" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Gliner2" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Qwen35.OnnxGenAI" Version="$(StarlingsVersion)" />
    <PackageReference Include="Starlings.Models.Qwen35.Extensions.AI" Version="$(StarlingsVersion)" />
    <!-- HTML parsing for the crawler. -->
    <PackageReference Include="AngleSharp" Version="1.9.1" />
    <!-- Exactly one ONNX Runtime native package, chosen by the application (CPU here). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="sample-site/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
